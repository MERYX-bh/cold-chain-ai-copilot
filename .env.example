# Copy this file to .env and fill in the values. Never commit .env.

# --- Agent settings ---
# LLM that reasons: OPENAI, DEEPSEEK or OLLAMA
Agent_llm=DEEPSEEK
# Embeddings for the SOP search: LOCAL or OPENAI
Embeddings_model=LOCAL
Local_Embedding_Model=BAAI/bge-m3

# 1 runs a scripted agent with canned data: the whole app works with no API keys and no database.
COLDCHAIN_DEMO=0

# --- API keys ---
PINECONE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# --- SQL Server ---
# Docker Compose overrides the host with its own database container.
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_ADMIN_USER=sa
# Needs upper case, lower case, a digit and a symbol (SQL Server password policy).
SQL_ADMIN_PASSWORD=
SQL_AGENT_USER=USR_FDE_RO
SQL_AGENT_PASSWORD=
